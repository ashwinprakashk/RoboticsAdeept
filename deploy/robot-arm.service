[Unit]
Description=Adeept robot arm web control (Flask)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/RoboticsAdeept/server
ExecStart=/usr/bin/python3 /home/pi/RoboticsAdeept/server/server.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
